<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Strictly enforce secure HTTPS/TLS for all network traffic in production -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
